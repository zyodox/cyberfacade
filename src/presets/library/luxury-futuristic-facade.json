    {
      "id": "crown",
      "generator": "grid",
      "name": "Crown",
      "blend": "add",
      "region": { "min": 0.9, "max": 1, "soft": 0.03 },
      "params": {
        "source": "arch", "lines": "horizontal", "everyY": 1, "offsetY": 0.08, "widthY": 0.05,
