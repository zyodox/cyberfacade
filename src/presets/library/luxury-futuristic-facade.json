    {
      "id": "corners",
      "generator": "grid",
      "name": "Corner lines",
      "blend": "add",
      "params": { "source": "arch", "lines": "none", "color": "#fff0dc", "intensity": 1, "glow": 0, "edges": 3.5, "edgeWidth": 2.5, "anim": "none" }
